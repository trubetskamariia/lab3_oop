<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lab3_oop.Views.AboutPage"
             Title="Про програму">

    <VerticalStackLayout Padding="30" Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="Лабораторна робота №3" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Тема: Кулінарна книга" HorizontalOptions="Center" />
        <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />
        <Label Text="Виконала: Трубецька Марія" />
        <Label Text="Курс: 2, Група: К-25" />
        <Label Text="Рік: 2026" />
        <Label Text="Додаток реалізовано за патерном MVC. Виконує читання та перезапис JSON-файлу, пошук за допомогою LINQ за 4 критеріями."
               Margin="0,10,0,20" MaximumWidthRequest="340" HorizontalTextAlignment="Center" />
        <Button Text="Закрити" Clicked="BtnClose_Clicked" WidthRequest="150" />
    </VerticalStackLayout>
</ContentPage>